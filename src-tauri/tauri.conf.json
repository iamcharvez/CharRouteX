{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CharRouteX",
  "version": "1.1.0",
  "identifier": "com.charroutex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:helper",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [{
      "label": "main",
      "title": "CharRouteX — Your Network. Your Control.",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 680,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../target/release/windows-helper.exe": "windows-helper.exe" },
    "shortDescription": "Advanced Windows network and routing management"
  }
}

